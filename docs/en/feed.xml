---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
<title>Dudelytics Crypto-Headlight</title>
<subtitle>The weekly briefing on the productive crypto market.</subtitle>
<id>{{ '/en/' | absolute_url | xml_escape }}</id>
<link href="{{ '/en/feed.xml' | absolute_url | xml_escape }}" rel="self"/>
<link href="{{ '/en/' | absolute_url | xml_escape }}"/>
<updated>{{ site.time | date_to_xmlschema }}</updated>
<author><name>Dudelytics</name><uri>https://dudelytics.com/</uri></author>
{% assign english_posts = site.posts | where: 'lang', 'en' %}
{% for post in english_posts limit: 20 %}<entry>
<title>{{ post.title | xml_escape }}</title>
<id>{{ post.url | absolute_url | xml_escape }}</id>
<link href="{{ post.url | absolute_url | xml_escape }}"/>
<updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
<published>{{ post.date | date_to_xmlschema }}</published>
<summary>{{ post.description | xml_escape }}</summary>
<content type="html">{{ post.content | xml_escape }}</content>
</entry>{% endfor %}
</feed>

